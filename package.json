{
  "name": "grilles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/fetch-ocr-assets.mjs",
    "dev": "npm run prepare:ocr && vite",
    "build": "npm run prepare:ocr && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:detect": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/dev-detect.mjs",
    "dev:ocr": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/dev-ocr.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "PWA de mots fléchés : photographie une grille de magazine, digitalise-la par OCR, remplis-la hors-ligne."
}
